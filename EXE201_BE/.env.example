# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/preorder_db
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/preorder_db

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Email Configuration (Gmail)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=your_email@gmail.com

# SMTP Configuration (Alternative to Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# OTP Configuration
OTP_EXPIRES_IN=300000
# OTP expires in 5 minutes (300000 milliseconds)

# Admin Account (for initial setup)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=System Administrator

# File Upload Configuration
MAX_FILE_SIZE=5242880
# Maximum file size: 5MB (5242880 bytes)

# Session Configuration
SESSION_SECRET=your_session_secret_here

# Rate Limiting
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME=900000
# Lockout time: 15 minutes (900000 milliseconds)

# Security
BCRYPT_ROUNDS=12
